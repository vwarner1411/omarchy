#!/bin/bash

# omarchy:summary=Overwrite the user config for the Limine bootloader and rebuild it.
# omarchy:requires-sudo=true

set -euo pipefail

OMARCHY_PATH="${OMARCHY_PATH:-$HOME/.local/share/omarchy}"

if [[ -f /boot/EFI/Linux/omarchy_linux.efi ]] && [[ -f /boot/EFI/Linux/$(cat /etc/machine-id)_linux.efi ]]; then
  echo "Cleanup extra UKI"
  sudo rm -f /boot/EFI/Linux/$(cat /etc/machine-id)_linux.efi
fi

if [[ -f /boot/limine.conf ]] &&
  grep -Eqi '^/Windows 11$|EFI/Microsoft/Boot/bootmgfw\.efi' /boot/limine.conf &&
  omarchy-cmd-present omarchy-setup-dualboot; then
  echo "Preserving dual-boot Limine config"
  omarchy-setup-dualboot
  exit
fi

if [[ -d /sys/firmware/efi ]]; then
  boot_fstype="$(findmnt -n -o FSTYPE /boot 2>/dev/null || true)"
  if [[ $boot_fstype != "vfat" ]]; then
    echo "Error: /boot is not a vfat ESP mount (found '$boot_fstype'). Refusing to rewrite Limine config." >&2
    exit 1
  fi
fi

if [[ ! -f /boot/limine.conf ]]; then
  echo "Error: /boot/limine.conf does not exist. Refusing to refresh Limine." >&2
  exit 1
fi

echo "Resetting limine config"

timestamp="$(date +%Y%m%d-%H%M%S)"
sudo cp -a /boot/limine.conf "/boot/limine.conf.bak.$timestamp"

sudo cp "$OMARCHY_PATH/default/limine/limine.conf" /boot/limine.conf

sudo limine-update
sudo limine-snapper-sync

if ! grep -q '^/' /boot/limine.conf; then
  echo "Error: Limine refresh produced no boot entries. Backup is /boot/limine.conf.bak.$timestamp" >&2
  exit 1
fi
