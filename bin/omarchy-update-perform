#!/bin/bash

# omarchy:summary=Run the full Omarchy update pipeline
# omarchy:requires-sudo=true

set -e

restore_dualboot_after_update=false
dualboot_windows_partuuid=""

if [[ -f /boot/limine.conf ]] && grep -Eqi '^/Windows 11$|EFI/Microsoft/Boot/bootmgfw\.efi' /boot/limine.conf; then
  restore_dualboot_after_update=true
  dualboot_windows_partuuid="$(grep -Eio 'guid\([0-9a-f-]+\):/EFI/Microsoft/Boot/bootmgfw\.efi' /boot/limine.conf | head -1 | sed -E 's/^guid\(([0-9a-f-]+)\):.*/\1/I' || true)"
fi

# Ensure screensaver/sleep doesn't set in during updates
hyprctl dispatch 'hl.dsp.window.tag({ tag = "+noidle" })' &>/dev/null || hyprctl dispatch tagwindow +noidle &>/dev/null || true

# Perform all update steps
omarchy-update-keyring
omarchy-update-available-reset
omarchy-update-system-pkgs
omarchy-migrate
omarchy-update-aur-pkgs
omarchy-update-orphan-pkgs

if [[ $restore_dualboot_after_update == "true" ]]; then
  echo -e "\e[32mRestore dual-boot Limine menu\e[0m"

  if ! omarchy-cmd-present omarchy-setup-dualboot; then
    echo "Error: Windows boot entry was present before update, but omarchy-setup-dualboot is unavailable." >&2
    exit 1
  fi

  if [[ -n $dualboot_windows_partuuid ]]; then
    omarchy-setup-dualboot --windows-partuuid "$dualboot_windows_partuuid"
  else
    omarchy-setup-dualboot
  fi
fi

omarchy-hook post-update

omarchy-update-analyze-logs

omarchy-update-restart

# Re-enable screensaver/sleep after updates
hyprctl dispatch 'hl.dsp.window.tag({ tag = "-noidle" })' &>/dev/null || hyprctl dispatch tagwindow -- -noidle &>/dev/null || true
