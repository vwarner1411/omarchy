{
  "version": 1,
  "idle": {
    "screensaver": 900,
    "lock": 960,
    "displayOff": 3600
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [],
      "right": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "io.github.edgarsilva.hw-monitor"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "cdelcollado.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "io.github.dragosol.better-displays-pro"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.clock",
          "format": "ddd d MMM HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        }
      ]
    }
  },
  "plugins": []
}
